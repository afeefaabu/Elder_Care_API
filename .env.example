PROJECT_NAME="Elder Care Production API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite by default for zero-setup, PostgreSQL ready)
DATABASE_URL="sqlite+aiosqlite:///./elder_care.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/elder_care"

# Security
SECRET_KEY="temporary-secret-key-for-elder-care-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 days

# Telephony & Push Dispatch (Mock mode enabled by default for safe local development)
MOCK_EXTERNAL_SERVICES=True
TWILIO_ACCOUNT_SID="mock_sid"
TWILIO_AUTH_TOKEN="mock_token"
TWILIO_FROM_PHONE="+15005550006"

# 25-Minute Watchdog Interval (in seconds for local testing check interval)
WATCHDOG_CHECK_INTERVAL_SECONDS=15
MISSED_MEDICATION_THRESHOLD_MINUTES=25
